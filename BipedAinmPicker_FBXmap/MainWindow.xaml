<Window x:Class="BipedAinmPicker_FBXmap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BipedAinmPicker_FBXmap"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--菜单栏-->

        <TabPanel Grid.Row="0"  MinWidth ="670" MinHeight="530">
            <TabItem Header="自定义" x:Name="MyCustom"  >
                <StackPanel Orientation="Horizontal" >
                        <Button Width="40" Height="20" Content="ffff" />
                </StackPanel>
            </TabItem>
            <TabItem Header="1" >
                <DockPanel LastChildFill="False">
                    <Button x:Name="a12" Content="button"/>
                </DockPanel>
            </TabItem>
        </TabPanel>
    </Grid>
</Window>
