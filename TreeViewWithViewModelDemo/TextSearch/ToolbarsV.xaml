<UserControl x:Class="NDToolsBox.TextSearch.ToolbarsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            
             xmlns:maxwpf ="clr-namespace:WPFCustomControls;assembly=WPFCustomControls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:NDToolsBox.TextSearch"
             xmlns:Nd="clr-namespace:NDToolsBox"
            
             mc:Ignorable="d" 
             x:Name="RootToolbars"
             MaxWidth="280" MinWidth="96" MinHeight="600" 
             >
    
    <UserControl.Resources>

        <FontFamily x:Key="IconFont">/NDToolsBox;Component/Fonts/#iconfont</FontFamily>

        <SolidColorBrush x:Key="HeadLineColor" Color="{Binding GetThemeColor}"/>

        <SolidColorBrush x:Key="MaxTextColor" Color="{Binding GetMaxTextColor}"/>
        <SolidColorBrush x:Key="MaxUiBackgroundColor" Color="{Binding GetMaxUiBackgroundColor}"/>
        <!--按钮的背景颜色-->
        <SolidColorBrush x:Key="ButtonColor_A" Color="{Binding GetButtonColor_A}"/>
        <SolidColorBrush x:Key="ButtonColor_B" Color="{Binding GetButtonColor_B}"/>
        <SolidColorBrush x:Key="ButtonColor_C" Color="{Binding GetButtonColor_C}"/>
        <SolidColorBrush x:Key="ButtonColor_D" Color="{Binding GetButtonColor_D}"/>


        <!--按钮的鼠标操作颜色-->
        <SolidColorBrush x:Key="ButtonColor_Mouse" Color="{Binding GetMouseOverColor}"/>
        <SolidColorBrush x:Key="ButtonColor_Mouse_Pressed" Color="{Binding GetMousePressedColor}"/>

        <SolidColorBrush x:Key="SecondaryButtonColor" Color="LightGray"/>

        <!-- 定义自定义的 ToggleButton 样式 -->
        <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True"  Margin="0,0,0,0" CornerRadius="2">
                            <TextBlock Foreground="{TemplateBinding Foreground}" x:Name="text" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Text="{TemplateBinding Content}" VerticalAlignment="Center" TextAlignment="Center" />

                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停时的触发器 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonColor_Mouse}"/>
                            </Trigger>
                            <!-- 按下时的触发器 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonColor_Mouse_Pressed}"/>
                            </Trigger>
                            <!-- 选中时的触发器 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonColor_Mouse_Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <!--第二排不可编辑按钮-->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource ButtonColor_A}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <TextBlock x:Name="tblock" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonColor_Mouse}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonColor_Mouse}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!--第一排可编辑按钮-->
        <Style x:Key="BtnInfoStyle" TargetType="Button">

            <Setter Property="FontSize" Value="11" />

            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource ButtonColor_A}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <StackPanel Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="edit_text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="0 0 0 0" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="edit_box" Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" VerticalContentAlignment="Center" KeyDown="OnKeyDownHandler" Margin="0 0 0 0" Width="{TemplateBinding Width}"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>

                            <DataTrigger Binding="{Binding IsEdit}" Value="false">
                                <Setter Property="Visibility" TargetName="edit_box" Value="Collapsed"/>
                                <Setter Property="Visibility" TargetName="edit_text" Value="Visible"/>

                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsEdit}" Value="true">
                                <Setter Property="Visibility" TargetName="edit_box" Value="Visible"/>
                                <Setter Property="Visibility" TargetName="edit_text" Value="Collapsed"/>

                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonColor_Mouse}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonColor_Mouse}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="listBoxItemStyle2" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="listBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="importBox" TargetType="{x:Type Button}">
            <Setter Property="BorderBrush" Value="{StaticResource ButtonColor_A}" />
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ButtonColor_A}" BorderThickness="1" SnapsToDevicePixels="True">

                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停时的触发器 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonColor_Mouse_Pressed}"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                    
                </Setter.Value>
            </Setter>
        </Style>
        
        <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="#FF333333"/>
        <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#FF333333"/>
        <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="#FF5593FF"/>
        <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="#FFF3F9FF"/>
        <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#FF000000"/>
        <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="#FF3C77DD"/>
        <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="#FFD9ECFF"/>
        <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#FF000000"/>
        <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="#FFBCBCBC"/>
        <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#FF707070"/>
        
        <Style x:Key="SettingButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryButtonColor}" />
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Content" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True" >
                                <Setter Property="Foreground" TargetName="Content" Value="{StaticResource HeadLineColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Padding="{TemplateBinding Padding}">
                            <Grid Background="Transparent" SnapsToDevicePixels="False" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="19"/>
                                    <ColumnDefinition Width="19"/>

                                </Grid.ColumnDefinitions>
                                <Path x:Name="arrow" Data="M 1,1.5 L 4.5,5 L 8,1.5" HorizontalAlignment="Center" Stroke="{StaticResource Expander.Static.Arrow.Stroke}" SnapsToDevicePixels="false" StrokeThickness="2" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,0" RecognizesAccessKey="True" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform >
                                        <TranslateTransform x:Name="ContentPresenter_text" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <Path x:Name="arrow2" Grid.Column="2" Data="M 1,1.5 L 4.5,5 L 8,1.5" HorizontalAlignment="Center" Stroke="{StaticResource Expander.Static.Arrow.Stroke}" SnapsToDevicePixels="false" StrokeThickness="2" VerticalAlignment="Center"/>
                                
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter Property="Data" TargetName="arrow" Value="M 1,4.5  L 4.5,1  L 8,4.5"/>
                                <Setter Property="Data" TargetName="arrow2" Value="M 1,4.5  L 4.5,1  L 8,4.5"/>

                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.MouseOver.Arrow.Stroke}"/>
                                <Setter Property="Stroke" TargetName="arrow2" Value="{StaticResource Expander.MouseOver.Arrow.Stroke}"/>

                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Pressed.Arrow.Stroke}"/>
                                <Setter Property="Stroke" TargetName="arrow2" Value="{StaticResource Expander.Pressed.Arrow.Stroke}"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentPresenter_text" Storyboard.TargetProperty="X" To="30" Duration="0:0:0.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentPresenter_text" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Stroke" TargetName="arrow" Value="{StaticResource Expander.Disabled.Arrow.Stroke}"/>
                                <Setter Property="Stroke" TargetName="arrow2" Value="{StaticResource Expander.Disabled.Arrow.Stroke}"/>

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpanderStyle1" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonColor_A}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" SnapsToDevicePixels="true">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" DockPanel.Dock="Top" FontStretch="{TemplateBinding FontStretch}" Foreground="{TemplateBinding Foreground}" FontStyle="{TemplateBinding FontStyle}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="0" MinWidth="0" MinHeight="0" Padding="{TemplateBinding Padding}" Style="{StaticResource ExpanderDownHeaderStyle}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="false" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="true">
                                <Setter Property="Visibility" TargetName="ExpandSite" Value="Visible"/>
                            </Trigger>
                            
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>


        </Style>
        <ContextMenu  x:Key="dynamicContextMenu" x:Shared="false" Opened="dynamicContextMenu_Opened" Background="{StaticResource MaxUiBackgroundColor}" Foreground="{DynamicResource MaxTextColor}"
                      DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="编辑" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding GEditItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="设置上下间距" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding SetItemSpacingCommand}"/>
            <MenuItem Header="插入间隔" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding AddMarginCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="复制" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding GCopyItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="黏贴" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding GPasetItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="删除" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding RemoverItem}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="保存配置" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding GSaveItemCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"/>
            <MenuItem Header="刷新" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Command="{Binding GReloadItemCommand}"/>
        </ContextMenu>
        <ContextMenu  x:Key="dynamicSpeedContextMenu" x:Name="SpeedContextMenu" Opened="dynamicSpeedContextMenu_Opened" Background="{StaticResource MaxUiBackgroundColor}" Foreground="{DynamicResource MaxTextColor}">
            <MenuItem Header="1/4x" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="MySpeedButton_S1_Click" />
            <MenuItem Header="1/2x" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="MySpeedButton_S2_Click" />
            <MenuItem Header="1x" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="MySpeedButton_S3_Click" />
            <MenuItem Header="2x" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="MySpeedButton_S4_Click" />
            <MenuItem Header="4x" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="MySpeedButton_S5_Click" />

        </ContextMenu>
        <ContextMenu  x:Key="customTabContextMenu" x:Shared="false" Background="{StaticResource MaxUiBackgroundColor}" Foreground="{DynamicResource MaxTextColor}">
            <MenuItem Header="重命名" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="CustomTabRename_Click"/>
            <MenuItem Header="删除" Background="{StaticResource MaxUiBackgroundColor}" BorderThickness="0" Click="CustomTabDelete_Click"/>
        </ContextMenu>
        <Style TargetType="{x:Type TabItem}" x:Key="TabItemStyle">
            <Setter Property="Panel.ZIndex" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <!-- 右边距略侵入内容，与内容区衔接；靠 ZIndex 保证 Tab 不被内容盖住 -->
                            <Border Name="Border" Background="{StaticResource MaxUiBackgroundColor}" Margin="0,2,-6,0" BorderBrush="Black" BorderThickness="1,1,0,1" CornerRadius="4" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" RecognizesAccessKey="True" />
                            </Border>
                            <Rectangle Height="100" Width="3" Margin="0,0,-6,0" Stroke="Black" VerticalAlignment="Bottom" HorizontalAlignment="Right" StrokeThickness="0" Fill="{StaticResource MaxUiBackgroundColor}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10"/>
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MaxUiBackgroundColor}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource HeadLineColor}" />
                                <Setter TargetName="Border" Property="BorderThickness" Value="2,2,0,2" />

                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FF6E6C67" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- 竖排正向：窄宽强制逐字换行，避免 Rotate 导致侧躺/颠倒 -->
                        <TextBlock Text="{Binding}"
                                   Width="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="12"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#FF6E6C67" />
            <Setter Property="Height" Value="90" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="DokChampa" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MaxTextColor}"/>
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style x:Key="tabGrids">
            <Setter Property="Grid.Background" Value="#FFE5E5E5" />
            <Setter Property="Grid.Margin" Value="6,10,10,10" />
        </Style>
    </UserControl.Resources>
    <StackPanel Background="{StaticResource MaxUiBackgroundColor}" HorizontalAlignment="Stretch">
        <TabControl x:Name="MainTabControl" BorderThickness="0 0 0 0" Padding ="0" Margin="0" TabStripPlacement="Left" Background="{StaticResource MaxUiBackgroundColor}" SelectionChanged="MainTabControl_SelectionChanged" HorizontalContentAlignment="Stretch">
            <TabItem Header="动画" Background ="{StaticResource ButtonColor_B}"  Width="14" Height="60" Margin="0" Padding="0" Style="{StaticResource TabItemStyle}" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="dockpanel" Orientation="Vertical" MinWidth="74" Margin="8,0,0,0" ClipToBounds="True" HorizontalAlignment="Stretch" Background="{StaticResource MaxUiBackgroundColor}" GotKeyboardFocus="dockpanel_GotKeyboardFocus" LostKeyboardFocus="dockpanel_LostKeyboardFocus" IsEnabledChanged="dockpanel_IsEnabledChanged">
                    <Expander Header="..." Style="{StaticResource ExpanderStyle1}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <!-- 宽按钮列表 -->
                    <ListBox x:Name="MyListBox" BorderThickness="0" Background="{StaticResource MaxUiBackgroundColor}" MinHeight="48" ItemContainerStyle="{StaticResource listBoxItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                    FocusVisualStyle="{x:Null}" ItemsSource="{Binding Items}" ContextMenu="{StaticResource dynamicContextMenu}" AllowDrop="True" Drop="MyListBox_Drop" DragEnter="MyListBox_DragEnter" DragOver="MyListBox_DragOver" MouseLeftButtonUp="MyListBox_MouseLeftButtonUp" Margin="2 0 2 0" HorizontalAlignment="Stretch"
                            >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                    <Button x:Name="MyListBoxButton" Content="{Binding Name}" ToolTip="{Binding ToolTip}" Background="{StaticResource ButtonColor_A}" Style="{StaticResource BtnInfoStyle}" Margin="0,1,4,2" MinWidth="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="Button_Click"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Space}" Value="true">
                                            <Setter Property="Margin" TargetName="MyListBoxButton" Value="0,5,4,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Space}" Value="false">
                                            <Setter Property="Margin" TargetName="MyListBoxButton" Value="0,1,4,2"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                
                    </ListBox>

                    </Expander>
                    <!-- 窄按钮列表：UniformGrid 均分，最多 4 列；左边距与宽列表一致（面板 Margin=8 + ListBox Margin=2） -->
                    <Expander Header="..." Style="{StaticResource ExpanderStyle1}" IsExpanded="True" Margin="0 5 0 0 " HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListBox x:Name="MyItemsControl" BorderThickness="0" ItemContainerStyle="{StaticResource listBoxItemStyle}" Background="{StaticResource MaxUiBackgroundColor}" MinHeight="48" ItemsSource="{Binding SolidItems}" ContextMenu="{StaticResource dynamicContextMenu}" AllowDrop="True" Drop="ItemsControl_Drop" DragEnter="MyListBox_DragEnter" DragOver="MyListBox_DragOver" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Margin="2 0 2 0" HorizontalAlignment="Stretch">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="MyItemsControlButon" Content="{Binding Name}" Margin="0,1,0,1" MinWidth="24"
                                            HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Style="{StaticResource BtnInfoStyle}" Background="{StaticResource ButtonColor_B}" Click="Button_Click"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Space}" Value="true">
                                            <Setter Property="Margin" TargetName="MyItemsControlButon" Value="0 15 0 1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Space}" Value="false">
                                            <Setter Property="Margin" TargetName="MyItemsControlButon" Value="0 1 0 1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <Expander Header="..." Style="{StaticResource ExpanderStyle1}" IsExpanded="True" Margin="0 5 0 0 "
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <!-- 固定 2 列；边距/宽度与上方列表一致（面板 8 + 此处 2,0,2,0；末列无列间距） -->
                        <StackPanel x:Name="AnimUtilityPanel" Margin="2,0,2,0" HorizontalAlignment="Stretch">
                            <UniformGrid x:Name="AnimUtilityGridLink" Columns="2" Background="{StaticResource MaxUiBackgroundColor}" HorizontalAlignment="Left">
                                <Button MinWidth="24" Margin="0,1,0,1" Style="{StaticResource BtnStyle}" Content="链接" Click="Button_Click_link" Background="{StaticResource ButtonColor_B}" ToolTip="先选的链接给后选" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <Button MinWidth="24" Margin="0,1,0,1" Style="{StaticResource BtnStyle}" Content="挂配" Click="Button_Click_Align" Background="{StaticResource ButtonColor_B}" ToolTip="先选对齐链接给后选" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                            </UniformGrid>

                            <UniformGrid x:Name="AnimUtilityGridVisA" Columns="2" Margin="0" Background="{StaticResource MaxUiBackgroundColor}" HorizontalAlignment="Left">
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Content="Bip" Click="ToggleButton_Checked_bip" Background="{StaticResource ButtonColor_C}" ToolTip="隐藏 biped" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Content="Bone" Click="ToggleButton_Checked_onlyBone" Background="{StaticResource ButtonColor_C}" ToolTip="隐藏 Bone" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Content="Box" Click="ToggleButton_Checked_box" Background="{StaticResource ButtonColor_C}" ToolTip="显示为 Box" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                            </UniformGrid>

                            <UniformGrid x:Name="AnimUtilityGridVisB" Columns="2" Margin="0,4,0,0" Background="{StaticResource MaxUiBackgroundColor}" HorizontalAlignment="Left">
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Mesh" Click="ToggleButton_Checked_Mesh" ToolTip="隐藏模型" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Shape" Click="ToggleButton_Checked_Shape" ToolTip="隐藏曲线形状" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Help" Click="ToggleButton_Checked_Help" ToolTip="隐藏Help" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Bone" Click="ToggleButton_Checked_Bone" ToolTip="隐藏骨骼" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Light" Click="ToggleButton_Checked_Light" ToolTip="隐藏灯光" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                <ToggleButton MinWidth="24" Height="20" Margin="0,1,0,1" Style="{StaticResource CustomToggleButtonStyle}" Background="{StaticResource ButtonColor_D}" Content="Camera" Click="ToggleButton_Checked_Camera" ToolTip="隐藏相机" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                            </UniformGrid>
                        </StackPanel>
                    </Expander>
                    

                    
            

                </StackPanel>
            </TabItem>
            <TabItem Header="绑定" Width="14" Height="60" Background ="{StaticResource ButtonColor_B}" Margin="0" Padding="0" Style="{StaticResource TabItemStyle}" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="rig_dockpanel" Orientation="Vertical" MinWidth="74" Margin="8,0,0,0" ClipToBounds="True" HorizontalAlignment="Stretch" Background="{StaticResource MaxUiBackgroundColor}" GotKeyboardFocus="dockpanel_GotKeyboardFocus" LostKeyboardFocus="dockpanel_LostKeyboardFocus" IsEnabledChanged="dockpanel_IsEnabledChanged">
                        <!--  -->
                    <Nd:NDListBox x:Name="MyListBox_Rig" />

                    <Nd:NDListBox x:Name="MyListBox_Rig_2" Margin="0 5 0 0" />

                    <Nd:NDListBox x:Name="MyListBox_Rig_3" Margin="0 5 0 0" />

                </StackPanel>
            </TabItem>
            <TabItem x:Name="AddTabItem" Header="+" Width="14" Height="40" Background ="{StaticResource ButtonColor_B}" Margin="0" Padding="0" Style="{StaticResource TabItemStyle}" ToolTip="左键新建 Tab，右键可导入" PreviewMouseLeftButtonDown="AddTabItem_PreviewMouseLeftButtonDown" PreviewMouseRightButtonUp="AddTabItem_PreviewMouseRightButtonUp"/>
        </TabControl>
        <Border BorderThickness="0, 2,0,0" CornerRadius="0" BorderBrush="{StaticResource ButtonColor_A}" Margin="0 10 0 0" HorizontalAlignment="Stretch">
            <!-- 始终单列；宽度由代码按内容区均分，不随 Tab 的 1/2 列档换行 -->
            <StackPanel x:Name="BottomBarPanel" Orientation="Vertical" Background="{DynamicResource MaxUiBackgroundColor}"
                        HorizontalAlignment="Stretch" Margin="0,5,0,0">
                <ToggleButton x:Name="MySpeedButton" Content="Speed" ToolTip="{Binding ToolTip}" Background="{StaticResource ButtonColor_A}" Style="{StaticResource CustomToggleButtonStyle}"
                              MinWidth="48" Height="22" Margin="0,1,0,2" ContextMenu="{StaticResource dynamicSpeedContextMenu}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Click="MySpeedButton_Click"/>
                <maxwpf:WpfSpinner x:Name="sp_start" MinWidth="48" Scale="1" Background="{StaticResource ButtonColor_A}" IsShowingEditBox="True" Value="{Binding TimeStart }" Precision="0" Margin="0,1,0,1" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                <maxwpf:WpfSpinner x:Name="sp_end" MinWidth="48" Scale="1" Background="{StaticResource ButtonColor_A}" IsShowingEditBox="True" Value="{Binding TimeEnd}" Precision="0" Margin="0,1,0,1" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                <Button x:Name="importA" Style="{StaticResource importBox}" ToolTip="FBX 拖拽到此" MinWidth="48" Height="30" Margin="0,1,0,2" HorizontalAlignment="Left" VerticalContentAlignment="Center" AllowDrop="True" Drop="inport_Drop" DragEnter="inport_DragEnter"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
